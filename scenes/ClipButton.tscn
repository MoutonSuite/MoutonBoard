[sub_resource type="Shader" id="Shader_1cjsc"]
code = "shader_type canvas_item;

uniform float progress : hint_range(0.0, 2.0) = 0.0;
uniform float size = 1;
uniform float border = 1;
uniform sampler2D color;
uniform sampler2D noise;
uniform sampler2D noise_mapping;

vec3 rgb2hsv(vec3 c) {
    vec4 K = vec4(0.0, -1.0 / 3.0, 2.0 / 3.0, -1.0);
    vec4 p = mix(vec4(c.bg, K.wz), vec4(c.gb, K.xy), step(c.b, c.g));
    vec4 q = mix(vec4(p.xyw, c.r), vec4(c.r, p.yzx), step(p.x, c.r));

    float d = q.x - min(q.w, q.y);
    float e = 1.0e-10;
    return vec3(abs(q.z + (q.w - q.y) / (6.0 * d + e)), d / (q.x + e), q.x);
}

vec3 hsv2rgb(vec3 c)
{
    vec4 K = vec4(1.0, 2.0 / 3.0, 1.0 / 3.0, 3.0);
    vec3 p = abs(fract(c.xxx + K.xyz) * 6.0 - K.www);
    return c.z * mix(K.xxx, clamp(p - K.xxx, 0.0, 1.0), c.y);
}

float form(vec2 uv) {
	float x = uv.x;
	float y = uv.y;
	float base = 0.0;
	if (x <= progress) {
		base = pow((1. - abs(progress - x)),size*10.);
	} else {
		base = 0.;
	}
	base -= pow((1. - abs(0.0 - y)),border*10.);
	base -= pow((1. - abs(1.0 - y)),border*10.);
	return clamp(base,0.0,1.0);
}

float s(float x) {
	return pow(sin(PI*x),2);
}

vec2 shift(vec2 uv) {
	return vec2(
		fract(uv.x + TIME/2.),
		uv.y
	);
}

void fragment() {
	float final = form(UV);
	//float noisy = s(texture(noise,shift(UV)).r + TIME*2.);
	//final = mix(COLOR.r, noisy, texture(noise_mapping, vec2(final)).r);

	COLOR.rgb = texture(color, vec2(final)).rgb;
	COLOR.a = final ;
}

"

